# Copy to .env and fill in. Never commit .env.

# --- LLM (Root Cause Analyst + Report Writer agents) ---
ANTHROPIC_API_KEY=
MAVIA_LLM_MODEL=claude-sonnet-5

# --- Vector memory ---
# Leave MAVIA_QDRANT_URL empty to use embedded on-disk Qdrant at MAVIA_QDRANT_PATH
# (no Docker required). Set it to http://localhost:6333 or a Qdrant Cloud URL to
# use a server instead.
MAVIA_QDRANT_URL=
MAVIA_QDRANT_API_KEY=
MAVIA_QDRANT_PATH=./artifacts/qdrant_storage
MAVIA_QDRANT_COLLECTION=defect_history

# --- Observability (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mavia

# --- Paths ---
MAVIA_DATA_DIR=./data
MAVIA_MODELS_DIR=./models
MAVIA_ARTIFACTS_DIR=./artifacts

# --- Decision policy ---
# Anomaly score above this routes the inspection to a human approval gate.
MAVIA_HIGH_RISK_THRESHOLD=0.75
MAVIA_RETRIEVAL_TOP_K=3
